rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }

    function isActiveMember(roomId) {
      return signedIn()
        && exists(memberPath(roomId, request.auth.uid))
        && get(memberPath(roomId, request.auth.uid)).data.status == 'active';
    }

    function roleFor(roomId) {
      return get(memberPath(roomId, request.auth.uid)).data.role;
    }

    function canManageRoom(roomId) {
      return isActiveMember(roomId) && roleFor(roomId) in ['owner', 'admin'];
    }

    function validText(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function optionalString(data, key, maximum) {
      return !data.keys().hasAny([key]) || (data[key] is string && data[key].size() <= maximum);
    }

    function validMention(mention, text) {
      return mention is map
        && mention.keys().hasAll(['type', 'id', 'label', 'start', 'end'])
        && mention.keys().hasOnly(['type', 'id', 'label', 'start', 'end'])
        && mention.type in ['user', 'bot']
        && validText(mention.id, 150)
        && validText(mention.label, 100)
        && mention.start is int
        && mention.end is int
        && mention.start >= 0
        && mention.end > mention.start
        && mention.end <= text.size();
    }

    function validMentionAt(mentions, text, index) {
      return mentions.size() <= index || validMention(mentions[index], text);
    }

    function validMentions(data) {
      return !data.keys().hasAny(['mentions']) || (
        data.mentions is list
        && data.mentions.size() <= 5
        && validMentionAt(data.mentions, data.text, 0)
        && validMentionAt(data.mentions, data.text, 1)
        && validMentionAt(data.mentions, data.text, 2)
        && validMentionAt(data.mentions, data.text, 3)
        && validMentionAt(data.mentions, data.text, 4)
      );
    }

    function validUserTextMessage(roomId, data) {
      return data.keys().hasAll([
          'roomId', 'senderId', 'senderType', 'senderDisplayName', 'kind', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'roomId', 'senderId', 'senderType', 'senderDisplayName', 'kind', 'text',
          'createdAt', 'clientCreatedAt', 'replyToId', 'mentions', 'editedAt', 'deletedAt'
        ])
        && data.roomId == roomId
        && data.senderId == request.auth.uid
        && data.senderType == 'user'
        && data.kind == 'text'
        && validText(data.senderDisplayName, 100)
        && validText(data.text, 4000)
        && data.createdAt == request.time
        && optionalString(data, 'replyToId', 150)
        && (!data.keys().hasAny(['clientCreatedAt']) || data.clientCreatedAt is number)
        && validMentions(data);
    }

    function validLastMessage(roomId, data) {
      return !data.keys().hasAny(['lastMessage']) || (
        data.lastMessage is map
        && data.lastMessage.keys().hasAll(['id', 'senderId', 'senderDisplayName', 'kind', 'preview', 'createdAt'])
        && data.lastMessage.keys().hasOnly(['id', 'senderId', 'senderDisplayName', 'kind', 'preview', 'createdAt'])
        && validText(data.lastMessage.id, 150)
        && data.lastMessage.senderId == request.auth.uid
        && validText(data.lastMessage.senderDisplayName, 100)
        && data.lastMessage.kind == 'text'
        && data.lastMessage.preview is string
        && data.lastMessage.preview.size() <= 160
        && data.lastMessage.createdAt == request.time
      );
    }

    function validReadState(data) {
      return data.keys().hasAll(['lastReadAt', 'lastReadMessageId', 'updatedAt'])
        && data.keys().hasOnly(['lastReadAt', 'lastReadMessageId', 'updatedAt'])
        && data.lastReadAt == request.time
        && data.updatedAt == request.time
        && validText(data.lastReadMessageId, 150);
    }

    function validPhotoURL(data) {
      return !data.keys().hasAny(['photoURL']) || (
        data.photoURL is string
        && data.photoURL.size() <= 500
        && data.photoURL.matches('https://[a-z0-9-]+[.]googleusercontent[.]com/.*')
      );
    }

    match /rooms/{roomId} {
      allow get, list: if signedIn() && (
        resource.data.visibility == 'public' || isActiveMember(roomId)
      );
      allow create, delete: if false;
      allow update: if isActiveMember(roomId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage'])
        && request.resource.data.updatedAt == request.time
        && validLastMessage(roomId, request.resource.data);

      match /members/{userId} {
        allow read: if isActiveMember(roomId);
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if isActiveMember(roomId);
        allow create: if isActiveMember(roomId) && validUserTextMessage(roomId, request.resource.data);
        allow update: if isActiveMember(roomId)
          && resource.data.senderType == 'user'
          && resource.data.senderId == request.auth.uid
          && !resource.data.keys().hasAny(['deletedAt'])
          && request.resource.data.roomId == resource.data.roomId
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.senderType == resource.data.senderType
          && request.resource.data.senderDisplayName == resource.data.senderDisplayName
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentions', 'editedAt', 'deletedAt'])
          && validText(request.resource.data.text, 4000)
          && validMentions(request.resource.data)
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt'])
              && request.resource.data.editedAt == request.time)
            || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedAt'])
              && request.resource.data.deletedAt == request.time)
          );
        allow delete: if false;
      }

      match /readStates/{userId} {
        allow read: if isActiveMember(roomId);
        allow create, update: if isActiveMember(roomId)
          && request.auth.uid == userId
          && validReadState(request.resource.data);
        allow delete: if isActiveMember(roomId) && request.auth.uid == userId;
      }

      match /reactions/{reactionId} {
        allow read: if isActiveMember(roomId);
        allow create, update: if isActiveMember(roomId)
          && request.resource.data.keys().hasAll(['messageId', 'userId', 'emoji', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['messageId', 'userId', 'emoji', 'updatedAt'])
          && reactionId == request.resource.data.messageId + '_' + request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && validText(request.resource.data.messageId, 150)
          && validText(request.resource.data.emoji, 16)
          && request.resource.data.updatedAt == request.time;
        allow delete: if isActiveMember(roomId) && resource.data.userId == request.auth.uid;
      }

      match /attachments/{attachmentId} {
        allow read: if isActiveMember(roomId);
        allow write: if false;
      }

      match /aiRequests/{requestId} {
        allow read: if isActiveMember(roomId);
        allow write: if false;
      }

      match /calls/{callId} {
        allow read: if isActiveMember(roomId);
        allow write: if false;
      }

      match /bots/{botId} {
        allow read: if isActiveMember(roomId);
        allow write: if canManageRoom(roomId) && false;
      }
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL'])
        && validText(request.resource.data.displayName, 100)
        && validPhotoURL(request.resource.data);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
        && validText(request.resource.data.displayName, 100)
        && validPhotoURL(request.resource.data);
      allow delete: if false;

      match /pushTokens/{tokenId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'updatedAt', 'userAgent'])
          && validText(request.resource.data.token, 500)
          && request.resource.data.updatedAt == request.time
          && optionalString(request.resource.data, 'userAgent', 300);
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /incomingCalls/{callId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /roomStates/{roomId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, delete: if false;
        allow update: if signedIn()
          && request.auth.uid == userId
          && resource.data.membershipStatus == 'active'
          && request.resource.data.membershipStatus == resource.data.membershipStatus
          && request.resource.data.role == resource.data.role
          && request.resource.data.roomName == resource.data.roomName
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastReadAt', 'lastReadMessageId', 'updatedAt'
          ])
          && request.resource.data.lastReadAt == request.time
          && request.resource.data.updatedAt == request.time
          && validText(request.resource.data.lastReadMessageId, 150);
      }

      match /stickerPacks/{packId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /bots/{botId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /directRoomKeys/{key} {
      allow read, write: if false;
    }

    match /membershipOperations/{operationId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /aiConcurrency/{limitId} {
      allow read, write: if false;
    }
  }
}
