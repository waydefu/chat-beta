# Public browser configuration. These values identify a Firebase app; they are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FCM_VAPID_KEY=
VITE_APP_CHECK_SITE_KEY=
VITE_FIREBASE_REGION=asia-east1

# Server-only secrets belong in Firebase Secret Manager, never in a VITE_ variable.
# GEMINI_API_KEY
# R2_ACCOUNT_ID
# R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY
# R2_BUCKET
# LIVEKIT_URL
# LIVEKIT_API_KEY
# LIVEKIT_API_SECRET
# ALGOLIA_APP_ID
# ALGOLIA_ADMIN_KEY
# ALGOLIA_INDEX_NAME
