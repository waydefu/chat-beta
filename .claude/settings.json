{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(firebase deploy *)",
      "PowerShell(firebase deploy *)",
      "Bash(pnpm deploy *)",
      "PowerShell(pnpm deploy *)",
      "Bash(pnpm run deploy *)",
      "PowerShell(pnpm run deploy *)",
      "Bash(git push --force *)",
      "PowerShell(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./functions/.env)",
      "Read(./functions/.env.local)",
      "Read(./artifacts/**)",
      "Read(./coverage/**)",
      "Read(./test-results/**)"
    ],
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:unit *)",
      "Bash(pnpm test:functions)",
      "Bash(pnpm test:rules)",
      "Bash(pnpm build)",
      "Bash(pnpm check)",
      "Bash(pnpm check:harness)",
      "Bash(pnpm eval:harness)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm audit *)",
      "Bash(pnpm preflight:rollout)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git switch -c agent/*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push origin agent/*)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr create *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gcloud logging read *)",
      "Bash(gcloud functions list *)",
      "Bash(gcloud scheduler jobs list *)",
      "Bash(gcloud scheduler jobs describe *)",
      "Bash(gcloud firestore indexes fields list *)",
      "Bash(gcloud firestore indexes fields describe *)",
      "Bash(gcloud firestore indexes composite list *)",
      "Bash(node --check *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commands.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking command against the harness guard"
          }
        ]
      }
    ]
  }
}
