{
  "rules": {
    ".read": false,
    ".write": false,
    "realtime": {
      "rooms": {
        "$roomKey": {
          ".read": "auth != null && data.child('members').child(auth.uid).child('status').val() === 'active'",
          "members": {
            "$uid": {
              ".write": false
            }
          },
          "membershipVersions": {
            "$uid": {
              ".write": false
            }
          },
          "presence": {
            "$uid": {
              "connections": {
                "$connectionId": {
                  ".write": "auth != null && auth.uid === $uid && root.child('realtime/rooms').child($roomKey).child('members').child(auth.uid).child('status').val() === 'active'",
                  ".validate": "!newData.exists() || (newData.hasChildren(['connectedAt', 'displayName']) && newData.child('connectedAt').isNumber() && newData.child('displayName').isString() && newData.child('displayName').val().length <= 100)"
                }
              }
            }
          },
          "typing": {
            "$uid": {
              "$connectionId": {
                ".write": "auth != null && auth.uid === $uid && root.child('realtime/rooms').child($roomKey).child('members').child(auth.uid).child('status').val() === 'active'",
                ".validate": "!newData.exists() || (newData.hasChildren(['displayName', 'updatedAt']) && newData.child('displayName').isString() && newData.child('displayName').val().length <= 100 && newData.child('updatedAt').isNumber())"
              }
            }
          },
          "activity": {
            "$uid": {
              "$connectionId": {
                ".write": "auth != null && auth.uid === $uid && root.child('realtime/rooms').child($roomKey).child('members').child(auth.uid).child('status').val() === 'active'",
                ".validate": "!newData.exists() || (newData.hasChildren(['state', 'updatedAt']) && newData.child('state').isString() && newData.child('state').val().length <= 30 && newData.child('updatedAt').isNumber())"
              }
            }
          },
          "aiDrafts": {
            "$runId": {
              ".write": false
            }
          }
        }
      }
    }
  }
}
