{
  "name": "chat-lite-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "audit:v3": "pnpm run build && node lib/migrations/migrate-v3.js --dry-run",
    "migrate:v3": "pnpm run build && node lib/migrations/migrate-v3.js --apply",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@google/genai": "^1.15.0",
    "algoliasearch": "^5.35.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "livekit-server-sdk": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
